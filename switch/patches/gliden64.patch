+// MM64NX: in the 16:9 adjust mode, 2D images keep the 4:3 image's size and place, so full-screen backgrounds leave the
+// widescreen areas at their sides empty. Mega Man 64's backgrounds are drawn as rows of texture rectangles that start
+// at the screen's left edge or end at its right edge with an edge of their texture; continue such rows outwards.
+// A row of several tiles is a repeating pattern (the pause menu), continued by repeating its tile; a row that is a
+// single wide image (the main menu) is mirrored, which joins without a seam.
+// Only images whose first row starts at the top of the screen count as backgrounds, so that sprites entering the
+// screen from its sides aren't copied.
+static void mm64nxExtendBackgroundRow(GraphicsDrawer & drawer, f32 ulx, f32 uly, f32 lrx, f32 lry, s16 s, s16 t,
+	f32 dsdx, f32 dtdy, bool flip)
+{
+	static u32 backgroundImageAddress = 0;
+	const gDPTile * tile0 = gSP.textureTile[0];
+	if (!dwnd().isAdjustScreen() || flip || dsdx != 1.0f || tile0 == nullptr)
+		return;
+	if (uly == 0.0f)
+		backgroundImageAddress = gDP.textureImage.address;
+	if (gDP.textureImage.address != backgroundImageAddress)
+		return;
+
+	const f32 tileWidth = tile0->flrs - tile0->fuls + 1.0f;
+	if (tileWidth < 16.0f)
+		return;
+	const f32 screenRight = static_cast<f32>(gDP.colorImage.width);
+	const f32 widescreenWidth = screenRight * (1.0f / dwnd().getAdjustScale() - 1.0f) / 2.0f;
+	const f32 startS = _FIXED2FLOAT(s, 5) - tile0->fuls;  // texel of the tile at ulx
+	const f32 endS = startS + (lrx - ulx);                 // texel of the tile at lrx
+	const bool singleImage = tileWidth >= 128.0f;
+	const s16 firstTexel = static_cast<s16>(tile0->fuls * 32.0f);
+	const s16 lastTexel = static_cast<s16>((tile0->fuls + tileWidth) * 32.0f);
+
+	const bool texCoordBoundsValid = gDP.m_texCoordBounds.valid;
+	gDP.m_texCoordBounds.valid = false;
+	auto draw = [&](f32 left, f32 right, s16 startTexel, f32 direction) {
+		GraphicsDrawer::TexturedRectParams extra(left, uly, right, lry, direction * dsdx, dtdy, startTexel, t,
+			false, false, true, frameBufferList().getCurrent());
+		drawer.drawTexturedRect(extra);
+	};
+
+	// Left edge: the row starts at x = 0 and runs to the end of its tile.
+	if (ulx == 0.0f && startS >= 0.0f && startS < tileWidth && fabsf(endS - tileWidth) <= 1.0f) {
+		if (singleImage) {
+			// Mirrored: the texel at x = -1 is the one at x = 0.
+			draw(-widescreenWidth, 0.0f, static_cast<s16>((tile0->fuls + startS + widescreenWidth) * 32.0f), -1.0f);
+		} else {
+			f32 right = 0.0f;
+			f32 width = startS > 0.0f ? startS : tileWidth;
+			while (right > -widescreenWidth) {
+				draw(right - width, right, firstTexel, 1.0f);
+				right -= width;
+				width = tileWidth;
+			}
+		}
+	}
+
+	// Right edge: the row ends at the screen's right edge with the end of its tile.
+	if (fabsf(lrx - screenRight) <= 1.0f && fabsf(endS - tileWidth) <= 1.0f) {
+		if (singleImage) {
+			draw(lrx, screenRight + widescreenWidth, lastTexel, -1.0f);
+		} else {
+			for (f32 left = lrx; left < screenRight + widescreenWidth; left += tileWidth)
+				draw(left, left + tileWidth, firstTexel, 1.0f);
+		}
+	}
+	gDP.m_texCoordBounds.valid = texCoordBoundsValid;
+}
