+    // Horizon has no API for naming threads.
+}
+
+void ultramodern::set_native_thread_priority(ThreadPriority pri) {
+    // Lower values are higher priority on Horizon. 0x2C is the default for the main thread.
+    int32_t priority = 0x2C;
+
+    switch (pri) {
+        case ThreadPriority::Low:
+            priority = 0x2E;
+            break;
+        case ThreadPriority::Normal:
+            priority = 0x2C;
+            break;
+        case ThreadPriority::High:
+            priority = 0x2B;
+            break;
+        case ThreadPriority::VeryHigh:
+            priority = 0x2A;
+            break;
+        case ThreadPriority::Critical:
+            priority = 0x28;
+            break;
+        default:
+            throw std::runtime_error("Invalid thread priority!");
+            break;
+    }
+    svcSetThreadPriority(CUR_THREAD_HANDLE, priority);
+
+    // Threads are created pinned to the process's default core. Allow them on the three application cores
+    // so that the kernel can migrate them, keeping the current core as the ideal one.
+    svcSetThreadCoreMask(CUR_THREAD_HANDLE, -3, 0b0111);
+}
 #elif defined(__APPLE__)
